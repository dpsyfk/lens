[Version]
Signature="$WINDOWS NT$"
Class=NetService
ClassGuid={4D36E974-E325-11CE-BFC1-08002BE10318}
Provider=%LensProvider%
DriverVer=07/30/2026,0.1.0.0
CatalogFile=LensWfp.cat
PnpLockdown=1

[DefaultInstall.NTamd64]
CopyFiles=LensWfp.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService=LensWfp,0x00000002,LensWfp.Service

[DefaultUninstall.NTamd64]
LegacyUninstall=1
DelFiles=LensWfp.DeleteFiles

[DefaultUninstall.NTamd64.Services]
DelService=LensWfp,0x00000200

[DestinationDirs]
LensWfp.CopyFiles=12
LensWfp.DeleteFiles=12

[SourceDisksNames]
1=%InstallDisk%,,,

[SourceDisksFiles]
LensWfp.sys=1

[LensWfp.CopyFiles]
LensWfp.sys

[LensWfp.DeleteFiles]
LensWfp.sys

[LensWfp.Service]
DisplayName=%LensServiceDescription%
Description=%LensServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\LensWfp.sys
LoadOrderGroup=PNP_TDI

[Strings]
LensProvider="Lens contributors"
LensServiceDescription="Lens transparent TCP redirect callout"
InstallDisk="Lens WFP installation media"
